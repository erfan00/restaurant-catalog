# Copy to .env and adjust as needed. All values shown are defaults used
# when the variable is unset, except secrets which you should change.

ENVIRONMENT=development
DEBUG=true

# SQLite (default, zero-config local dev):
DATABASE_URL=sqlite+aiosqlite:///./restaurant_catalog.db

# Postgres (production): uncomment and set real credentials.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/restaurant_catalog

SECRET_KEY=please-change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=["http://localhost:5173"]

# Optional real Google OAuth2 (leave unset to keep Google login disabled
# and use the password/JWT flow instead - see README "Auth flow").
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
